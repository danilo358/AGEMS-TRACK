AGEMS_SECRET_KEY=gere-uma-chave-aleatoria-longa
AGEMS_USERNAME=usuario-da-agems
AGEMS_PASSWORD=senha-da-agems
SYSTEMSAT_HASH_AUTH=hash-de-integracao
SYSTEMSAT_USERNAME=usuario-do-systemsat
SYSTEMSAT_PASSWORD=senha-do-systemsat
MAPBOX_TOKEN=chave-mapbox-nova
DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require
PORT=8080
FLASK_DEBUG=0
# Número de veículos consultados em paralelo na Análise de Grade.
ANALISE_GRADE_WORKERS=10
# Timeout de cada janela de 6 horas do histórico (em segundos).
ANALISE_GRADE_TIMEOUT=240
# Tentativas da mesma janela antes de subdividi-la em duas.
ANALISE_GRADE_TENTATIVAS_TIMEOUT=2
# Menor janela permitida para recuperar posições após timeouts.
ANALISE_GRADE_JANELA_MINUTOS=15
